FrameWidgetClass rootFrame {
 size 1 50
 halign center_ref
 hexactpos 0
 vexactpos 1
 hexactsize 0
 vexactsize 1
 {
  ButtonWidgetClass SectionHeader {
   color 0 0 0 0
   size 1 44
   halign center_ref
   hexactpos 0
   vexactpos 1
   hexactsize 0
   vexactsize 1
   style Colorable
   {
    PanelWidgetClass HeaderBackground {
     ignorepointer 1
     color 0.12 0.13 0.16 0.95
     size 1 1
     halign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style rover_sim_colorable
    }
    PanelWidgetClass HeaderAccent {
     ignorepointer 1
     color 0.85 0.65 0.3 1
     size 4 0.7
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 0
     style rover_sim_colorable
    }
    TextWidgetClass CollapseIcon {
     ignorepointer 1
     color 0.5 0.8 0.85 1
     position 18 0
     size 24 1
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 0
     text "-"
     font "gui/fonts/sdf_MetronLight24"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass SectionTitle {
     ignorepointer 1
     color 1 1 1 0.95
     position 48 0
     size 0.9 1
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "Section Title"
     font "gui/fonts/sdf_MetronLight24"
     "text valign" center
    }
   }
  }
  FrameWidgetClass ContentFrame {
   ignorepointer 1
   position 0 48
   size 1 0
   halign center_ref
   hexactpos 0
   vexactpos 1
   hexactsize 0
   vexactsize 1
   {
    PanelWidgetClass ContentBackground {
     ignorepointer 1
     color 0.08 0.09 0.11 0.9
     size 1 1
     halign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style rover_sim_colorable
    }
    GridSpacerWidgetClass ContentGrid {
     ignorepointer 1
     position 20 8
     size 0.95 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     Padding 2
     Margin 0
     "Size To Content V" 1
     Columns 1
     Rows 99
    }
   }
  }
 }
}
