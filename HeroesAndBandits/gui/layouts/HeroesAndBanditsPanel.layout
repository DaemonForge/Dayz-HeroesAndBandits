FrameWidgetClass rootFrame {
 ignorepointer 1
 position 0 0
 size 0.9 0.9
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass BackgroundOverlay {
   ignorepointer 1
   color 0 0 0 0.7
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
  }
