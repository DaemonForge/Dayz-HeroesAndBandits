FrameWidgetClass rootFrame {
 clipchildren 0
 position 0 0
 size 1000 680
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 1
 vexactsize 1
 {
  PanelWidgetClass BackgroundOverlay {
   ignorepointer 1
   color 0 0 0 0.75
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
  }
  PanelWidgetClass MainContainer {
   ignorepointer 1
   color 0.08 0.09 0.12 0.98
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
   {
    PanelWidgetClass HeaderBar {
     ignorepointer 1
     color 0.12 0.13 0.18 1
     position 5 0
     size 1 60
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     style rover_sim_colorable
     {
      PanelWidgetClass HeaderAccent {
       ignorepointer 1
       color 0.85 0.65 0.3 1
       position 0 0
       size 1 3
       halign center_ref
       valign bottom_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 1
       style rover_sim_colorable
      }
      TextWidgetClass TitleText {
       ignorepointer 1
       color 1 1 1 1
       size 1 0.95
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text "#HAB_TITLE"
       font "gui/fonts/sdf_MetronLight72"
       "text valign" center
      }
     }
    }
    FrameWidgetClass TabContainer {
     ignorepointer 1
     position 0 60
     size 1 48
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     {
      PanelWidgetClass TabBackground {
       ignorepointer 1
       color 0.06 0.07 0.09 1
       position 0 0
       size 1 1
       halign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style rover_sim_colorable
      }
      FrameWidgetClass Menu {
       ignorepointer 1
       position 5 0
       size 550 1
       valign center_ref
       hexactpos 1
       vexactpos 0
       hexactsize 1
       vexactsize 0
       {
        ButtonWidgetClass StatsButton {
         color 0 0 0 0
         position 0 0
         size 120 36
         valign center_ref
         hexactpos 1
         vexactpos 0
         hexactsize 1
         vexactsize 1
         style Colorable
         {
          PanelWidgetClass StatsButton_Active {
           ignorepointer 1
           color 0.85 0.65 0.3 1
           position 0 0
           size 1 3
           halign center_ref
           valign bottom_ref
           hexactpos 0
           vexactpos 1
           hexactsize 0
           vexactsize 1
           style rover_sim_colorable
          }
          TextWidgetClass StatsButton_Label {
           ignorepointer 1
           color 1 1 1 0.9
           size 1 1
           halign center_ref
           valign center_ref
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           text "#HAB_STATS"
           font "gui/fonts/sdf_MetronLight24"
           "text halign" center
           "text valign" center
          }
         }
        }
        ButtonWidgetClass LeaderboardsButton {
         color 0 0 0 0
         position 126 0
         size 284 36
         valign center_ref
         hexactpos 1
         vexactpos 0
         hexactsize 1
         vexactsize 1
         style Colorable
         {
          PanelWidgetClass LeaderboardsButton_Active {
           visible 0
           ignorepointer 1
           color 0.85 0.65 0.3 1
           position 0 0
           size 1 3
           halign center_ref
           valign bottom_ref
           hexactpos 0
           vexactpos 1
           hexactsize 0
           vexactsize 1
           style rover_sim_colorable
          }
          TextWidgetClass LeaderboardsButton_Label {
           ignorepointer 1
           color 1 1 1 0.5
           size 1 1
           halign center_ref
           valign center_ref
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           text "#HAB_LEADERBOARDS"
           font "gui/fonts/sdf_MetronLight24"
           "text halign" center
           "text valign" center
          }
         }
        }
        ButtonWidgetClass InfoButton {
         color 0 0 0 0
         position 418 0
         size 110 36
         valign center_ref
         hexactpos 1
         vexactpos 0
         hexactsize 1
         vexactsize 1
         style Colorable
         {
          PanelWidgetClass InfoButton_Active {
           visible 0
           ignorepointer 1
           color 0.85 0.65 0.3 1
           position 0 0
           size 1 3
           halign center_ref
           valign bottom_ref
           hexactpos 0
           vexactpos 1
           hexactsize 0
           vexactsize 1
