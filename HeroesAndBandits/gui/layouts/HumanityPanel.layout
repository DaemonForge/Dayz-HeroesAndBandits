           "text halign" center
           "text valign" center
          }
         }
        }
       }
      }
     }
    }
    FrameWidgetClass Page {
     ignorepointer 1
     position 0 108
     size 1 0.8
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 0
    }
    TextWidgetClass Footer {
     ignorepointer 1
     color 0.5 0.5 0.5 0.35
     size 0.9 28
     halign center_ref
     valign bottom_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "#HAB_TITLE Mod - Made By DaemonForge Developments"
     font "gui/fonts/sdf_MetronLight24"
     "text halign" center
     "text valign" center
