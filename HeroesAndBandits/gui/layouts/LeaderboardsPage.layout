FrameWidgetClass rootFrame {
 position 0 0
 size 1 1
 halign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  FrameWidgetClass LeaderboardContainer {
   ignorepointer 1
   position 0 15
   size 0.96 0.96
   halign center_ref
   hexactpos 0
   vexactpos 1
   hexactsize 0
   vexactsize 0
   {
    FrameWidgetClass Heroes {
     ignorepointer 1
     position 0 0
     size 0.49 1
     halign right_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     {
      PanelWidgetClass HeroContainer {
       ignorepointer 1
       color 0.1 0.11 0.14 0.95
       position 0 0
       size 1 1
       halign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style rover_sim_colorable
      }
      PanelWidgetClass HeroAccent {
       ignorepointer 1
       color 0.2 0.45 0.8 1
       position 0 0
       size 1 4
       halign center_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 1
       style rover_sim_colorable
      }
      FrameWidgetClass HeroHeader {
       ignorepointer 1
       position 0 8
       size 1 44
       halign center_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 1
       {
        TextWidgetClass HeroTitle {
         ignorepointer 1
         color 0.2 0.45 0.8 1
         position 15 0
         size 0.9 1
         valign center_ref
         hexactpos 1
         vexactpos 0
         hexactsize 0
         vexactsize 0
         text "#HAB_HEROES"
         font "gui/fonts/sdf_MetronLight48"
         "text valign" center
        }
       }
      }
      FrameWidgetClass HeroBoardFrame {
       ignorepointer 1
       position 0 56
       size 1 0.86
       halign center_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 0
       {
        ScrollWidgetClass HeroScroll {
         ignorepointer 1
         position 0 0
         size 1 1
         halign center_ref
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         "Scrollbar V" 1
         {
          GridSpacerWidgetClass HeroGrid {
           ignorepointer 1
           size 0.96 1
           halign center_ref
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           Padding 3
           Margin 6
           "Size To Content V" 1
           Columns 1
           Rows 100
          }
         }
        }
       }
      }
     }
    }
    FrameWidgetClass Bandits {
     ignorepointer 1
     position 0 0
     size 0.49 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     {
      PanelWidgetClass BanditContainer {
       ignorepointer 1
       color 0.1 0.11 0.14 0.95
       position 0 0
       size 1 1
       halign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style rover_sim_colorable
      }
      PanelWidgetClass BanditAccent {
       ignorepointer 1
       color 0.8 0.25 0.2 1
       position 0 0
       size 1 4
       halign center_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 1
       style rover_sim_colorable
      }
      FrameWidgetClass BanditHeader {
       ignorepointer 1
       position 0 8
       size 1 44
       halign center_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 1
       {
        TextWidgetClass BanditTitle {
         ignorepointer 1
         color 0.8 0.25 0.2 1
         position 15 0
         size 0.9 1
         valign center_ref
         hexactpos 1
         vexactpos 0
         hexactsize 0
         vexactsize 0
         text "#HAB_BANDITS"
         font "gui/fonts/sdf_MetronLight48"
         "text valign" center
        }
       }
      }
      FrameWidgetClass BanditBoardFrame {
       ignorepointer 1
       position 0 56
       size 1 0.86
       halign center_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 0
       {
        ScrollWidgetClass BanditScroll {
         ignorepointer 1
         position 0 0
         size 1 1
         halign center_ref
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         "Scrollbar V" 1
         {
          GridSpacerWidgetClass BanditGrid {
           ignorepointer 1
           size 0.96 1
           halign center_ref
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           Padding 3
           Margin 6
           "Size To Content V" 1
           Columns 1
           Rows 100
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
